#MenuRoot {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 24, 32);
    color: rgb(245, 245, 235);
}
#MenuCard {
    width: 1160px;
    padding: 32px 48px;
    align-items: center;
    background-color: rgb(25, 42, 49);
    border-width: 3px;
    border-color: rgb(226, 184, 83);
    border-radius: 20px;
}
.menu-kicker { font-size: 28px; color: rgb(255, 220, 140); -unity-text-align: middle-center; }
#MenuPortrait {
    width: 125px;
    height: 134px;
    margin-top: 12px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_2DAdventureGame/Art/Ducko/UI/CharacterPortrait.png?fileID=21300000&guid=0332b35b8fe3cf8458eb0558889493d1&type=3");
}
#GameTitle { font-size: 76px; -unity-font-style: bold; color: rgb(255, 220, 140); -unity-text-align: middle-center; margin: 8px 0 12px; }
#GameGoal { width: 100%; font-size: 34px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 20px; }
.menu-text { width: 100%; font-size: 28px; white-space: normal; -unity-text-align: middle-center; margin-top: 8px; }
#StartButton { width: 420px; height: 86px; margin-top: 28px; font-size: 36px; -unity-font-style: bold; color: rgb(18, 29, 34); background-color: rgb(255, 216, 118); border-width: 3px; border-color: rgb(255, 216, 118); border-radius: 10px; }
#StartButton:hover, #StartButton:focus { background-color: rgb(255, 235, 176); border-color: white; }
#StartButton:active { background-color: rgb(211, 171, 79); }
#ExitButton { width: 320px; height: 66px; margin-top: 12px; font-size: 30px; color: white; background-color: rgb(42, 65, 73); border-width: 2px; border-color: rgb(133, 170, 177); border-radius: 10px; }
#ExitButton:hover, #ExitButton:focus { background-color: rgb(63, 88, 96); border-color: white; }
#VersionLabel { font-size: 28px; color: rgb(204, 222, 223); margin-top: 20px; -unity-text-align: middle-center; }
